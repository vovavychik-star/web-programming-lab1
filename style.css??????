:root {
    --mint: #B9E5C8;
    --espresso: #2B1A12;
    --espresso-light: #4A3125;
    --bg-light: #F4F9F6;
    --white: #FFFFFF;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-light);
    color: var(--espresso);
    padding: 20px;
    display: flex;
    justify-content: center;
    min-height: 100vh;
}

.app-container {
    background: var(--white);
    width: 100%;
    max-width: 600px;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 8px 24px rgba(43, 26, 18, 0.08);
    border-top: 8px solid var(--mint);
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: fit-content;
}

header h1 {
    font-size: 28px;
    color: var(--espresso);
    text-align: center;
    margin-bottom: 5px;
}

.todo-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--bg-light);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid var(--mint);
}

.form-row {
    display: flex;
    gap: 10px;
}

input, select, button {
    padding: 10px 14px;
    border-radius: 6px;
    border: 1px solid #ccc;
    font-size: 14px;
    outline: none;
}

input:focus, select:focus {
    border-color: var(--espresso);
}

input[type="text"] {
    flex: 1;
}

.btn-main {
    background-color: var(--espresso);
    color: var(--mint);
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-main:hover {
    background-color: var(--espresso-light);
}

.controls-panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.search-input {
    width: 100%;
}

.filter-sort-row {
    display: flex;
    gap: 10px;
}

.filter-sort-row select {
    flex: 1;
}

.todo-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.todo-item {
    background: var(--white);
    border: 1px solid #e2ece6;
    padding: 15px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    cursor: grab;
    transition: transform 0.2s, box-shadow 0.2s;
}

.todo-item:active {
    cursor: grabbing;
}

/*   Drag and Drop */
.todo-item.dragging {
    opacity: 0.5;
    background: var(--bg-light);
    border: 2px dashed var(--espresso);
}

.todo-item-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
}

.todo-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--espresso);
}

.todo-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

.todo-text {
    font-weight: 500;
    font-size: 16px;
    color: var(--espresso);
}

.todo-date {
    font-size: 12px;
    color: #777;
}

.todo-item.completed {
    background-color: var(--mint);
    border-color: var(--mint);
}

.todo-item.completed .todo-text {
    text-decoration: line-through;
    color: var(--espresso-light);
    opacity: 0.7;
}

.actions-row {
    display: flex;
    gap: 5px;
}

.btn-icon {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    padding: 5px;
    border-radius: 4px;
    transition: background 0.2s;
}

.btn-icon:hover {
    background: rgba(0, 0, 0, 0.05);
}

/* - */
.edit-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
}

.edit-input {
    font-size: 16px;
    padding: 6px;
    width: 100%;
}

.edit-date {
    font-size: 12px;
    padding: 4px;
    width: 100%;
}

@media (max-width: 480px) {
    .form-row, .filter-sort-row {
        flex-direction: column;
    }
    .app-container {
        padding: 15px;
    }
}

